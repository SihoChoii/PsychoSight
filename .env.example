# Copy to .env (gitignored) and paste your DeepSeek key:  cp .env.example .env
# Also read from ~/.psychosight/.env. Real environment variables take precedence over this file.
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_MODEL=deepseek-flash

# Optional:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_REASONING_EFFORT=max        # low | high | max; none disables thinking
# DEEPSEEK_TIMEOUT_S=300
# PSYCHOSIGHT_LLM_CONCURRENCY=8
# PSYCHOSIGHT_EXP_LLM_CONCURRENCY=24
# PSYCHOSIGHT_EXP_OVERLAP=1            # 0 = run experimental calls after synthesis
# PSYCHOSIGHT_PORT=8765
# PSYCHOSIGHT_DEMO_PROVIDER=mock       # mock (offline) or deepseek for the demo conversation
