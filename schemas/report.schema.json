    "expDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "family",
        "evidence_strength",
        "evidence_note",
        "citations",
        "per_speaker"
      ],
      "properties": {
        "key": {
          "enum": [
            "openness",
            "conscientiousness",
            "extraversion",
            "agreeableness",
            "neuroticism",
            "depression_language",
            "anxiety_language",
            "addictive_language",
            "anger_hostility_language",
            "narcissism_language",
            "attachment_anxious_language",
            "attachment_avoidant_language"
          ]
        },
        "label": {
          "type": "string"
        },
        "family": {
          "enum": [
            "big_five",
            "wellbeing_language",
            "interpersonal"
          ]
        },
        "evidence_strength": {
          "enum": [
            "moderate",
            "small",
            "weak",
            "very_weak"
          ]
        },
        "evidence_note": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expCitation"
          }
        },
        "per_speaker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "me",
            "other"
          ],
          "properties": {
            "me": {
              "$ref": "#/$defs/expSpeakerScore"
            },
            "other": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/expSpeakerScore"
                }
              ]
            }
          }
        }
      }
    },
    "expCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "short",
        "doi"
      ],
      "properties": {
        "short": {
          "type": "string"
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "expSpeakerScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "score",
        "band",
        "confidence",
        "n_episodes",
        "n_words",
        "contributions",
        "trend",
        "quote_ids"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/sectionStatus"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "band": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lo",
                "hi"
              ],
              "properties": {
                "lo": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "hi": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            null
          ],
          "description": "low or medium only; null unless status is ok."
        },
        "n_episodes": {
          "type": "integer",
          "minimum": 0
        },
        "n_words": {
          "type": "integer",
          "minimum": 0
        },
        "contributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expContribution"
          }
        },
        "trend": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expTrendPoint"
          }
        },
        "quote_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "integer"
              },
              "band": {
                "type": "object"
              },
              "confidence": {
                "enum": [
                  "low",
                  "medium"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "null"
              },
              "band": {
                "type": "null"
              },
              "confidence": {
                "type": "null"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "expContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker_key",
        "label",
        "source",
        "direction",
        "weight",
        "value",
        "unit",
        "sub_score",
        "anchor_source",
        "status",
        "quote_ids"
      ],
      "properties": {
        "marker_key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "source": {
          "enum": [
            "D",
            "R",
            "H"
          ],
          "description": "D word counts, R AI episode rating, H overall AI rating."
        },
        "direction": {
          "enum": [
            "up",
            "down"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Effective share of the index after caps; 0 when the marker has no data."
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "% of words",
            "% of messages",
            "1-5 rubric",
            "lexicon units per 100 words",
            "share of episodes",
            "valence"
          ]
        },
        "sub_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "anchor_source": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "not_run",
            "no_data"
          ]
        },
        "quote_ids": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expTrendPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "week",
        "score",
        "n_episodes",
        "n_words",
        "reason"
      ],
      "properties": {
        "week": {
          "type": "string",
          "pattern": "^[0-9]{4}-W[0-9]{2}$"
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "n_episodes": {
          "type": "integer",
          "minimum": 0
        },
        "n_words": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "expQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "speaker",
        "episode_id",
        "marker_key",
        "text",
        "ts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^xq_[0-9]{3,}$"
        },
        "speaker": {
          "$ref": "#/$defs/speaker"
        },
        "episode_id": {
          "type": "string"
        },
        "marker_key": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Verbatim span of one message by this speaker."
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
